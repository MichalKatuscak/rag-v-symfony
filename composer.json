{
    "name": "katuscak/rag-v-symfony",
    "description": "RAG v Symfony nad lokální Ollamou: měření hledání, citací a tichých chyb na českých podkladech fiktivního e-shopu.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "ext-pdo_pgsql": "*",
        "doctrine/dbal": "^4.2",
        "doctrine/doctrine-bundle": "^3.0",
        "symfony/console": "8.1.*",
        "symfony/doctrine-messenger": "8.1.*",
        "symfony/dotenv": "8.1.*",
        "symfony/framework-bundle": "8.1.*",
        "symfony/http-client": "8.1.*",
        "symfony/messenger": "8.1.*",
        "symfony/runtime": "8.1.*",
        "symfony/string": "8.1.*",
        "symfony/translation-contracts": "^3.6",
        "symfony/uid": "8.1.*",
        "symfony/yaml": "8.1.*"
    },
    "autoload": {
        "psr-4": { "App\\": "src/" }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": { "symfony/runtime": true }
    }
}
